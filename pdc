def cmd_status(args):
    """Exibe status de todos os containers PDC."""
    import urllib.error
    import urllib.request

    header("Status dos Containers PDC")

    all_ok = True
    try:
        from shared.device_telemetry import load_host_telemetry

        telemetry = load_host_telemetry(
            str(BASE_DIR / "data" / "telemetry" / "host.json"), max_age_sec=10)
        if telemetry:
            platform_info = telemetry.get("platform", {})
            platform_name = platform_info.get("model") or platform_info.get("family") or "Linux"
            sources = ", ".join(telemetry.get("sources", [])) or "sysfs"
            print(f"  {GREEN}{'telemetria':8}{RESET}  local  ok        "
                  f"{platform_name} [{sources}]")
        else:
            print(f"  {RED}{'telemetria':8}{RESET}  local  {RED}OFFLINE{RESET}")
            all_ok = False
    except Exception:
        print(f"  {RED}{'telemetria':8}{RESET}  local  {RED}OFFLINE{RESET}")
        all_ok = False
    for front, cfg in FRONTS.items():
        port = cfg["port"]
        try:
            with urllib.request.urlopen(f"http://localhost:{port}/health", timeout=3) as r:
                data = json.loads(r.read())
            status = data.get("status", "?")
            if front == "audio":
                model = f"ASR: {data.get('asr', '?')} / TTS: {data.get('tts', '?')}"
            else:
                model = data.get("model", "?")
            gpu = "GPU" if data.get("gpu") else "CPU"
            color = GREEN if status == "ok" else YELLOW
            print(f"  {color}{front:8}{RESET}  :{port}  {status:8}  {model}  [{gpu}]")
        except urllib.error.HTTPError as exc:
            try:
                data = json.loads(exc.read())
            except Exception:
                data = {}
            status = data.get("status", "degraded")
            if front == "audio":
                model = f"ASR: {data.get('asr', '?')} / TTS: {data.get('tts', '?')}"
            else:
                model = data.get("model", "?")
            print(f"  {YELLOW}{front:8}{RESET}  :{port}  {status:8}  {model}")
            all_ok = False
        except Exception:
            print(f"  {RED}{front:8}{RESET}  :{port}  {RED}OFFLINE{RESET}")
            all_ok = False

    if all_ok:
        print(f"\n{GREEN}Todos os containers estão rodando!{RESET}")
    else:
        print(f"\n{YELLOW}Alguns containers estão offline. Use './pdc up <front>' para subir.{RESET}")
        raise SystemExit(1)


def _wait_healthy(port, timeout=300):
    """Espera a frente responder /health. Retorna True se ficou pronta a tempo.

    O container tem start_period longo (carrega modelo). Sem esperar, o
    benchmark bate numa porta que ainda recusa conexao e falha sem motivo.
    """
    import urllib.request
    deadline = time.time() + timeout
    url = f"http://localhost:{port}/health"
    while time.time() < deadline:
        try:
            with urllib.request.urlopen(url, timeout=5) as r:
                if r.status == 200:
                    return True
        except Exception:
            pass
        time.sleep(3)
    return False


def cmd_benchmark(args):
    """Executa benchmark em um ou todos os containers."""
    import urllib.error
    import urllib.request

    fronts = list(FRONTS.keys()) if args.front == "all" else [args.front]
    profile = "quick" if args.quick else getattr(args, "profile", "quick") or "quick"
    mode = getattr(args, "mode", None)
    if mode and args.front not in ("audio", "all"):
        err("--mode é válido apenas para a frente audio ou all")
        raise SystemExit(1)

    try:
        _, snapshot, _ = _capture_host_hardware()
        info(f"Inventário físico atualizado: {snapshot['hardware_id']}")
    except Exception as exc:
        warn(f"Benchmark seguirá sem atualizar o inventário físico: {exc}")

    failures = 0
    for front in fronts:
        if front not in FRONTS:
            err(f"Frente desconhecida: {front}")
            continue

        port = FRONTS[front]["port"]
        mode_label = f", modo: {mode}" if front == "audio" and mode else ""
        info(f"Benchmark {front} (perfil: {profile}{mode_label})...")

        if not _wait_healthy(port):
            err(f"{front} não ficou saudável a tempo na porta {port}")
            failures += 1
            continue

        try:
            request_data = {"profile": profile}
            if front == "audio" and mode:
                request_data["mode"] = mode
            payload = json.dumps(request_data).encode()
            # 409 = ainda há um benchmark rodando: numa placa lenta o lock do
            # container leva um instante para liberar após a rep anterior. Espera
            # e tenta de novo em vez de contar como falha.
            result = None
            for tentativa in range(6):
                req = urllib.request.Request(
                    f"http://localhost:{port}/benchmark",
                    data=payload,
                    headers={"Content-Type": "application/json"},
                    method="POST",
                )
                try:
                    with urllib.request.urlopen(req, timeout=args.timeout) as r:
                        result = json.loads(r.read())
                    break
                except urllib.error.HTTPError as http_exc:
                    if http_exc.code == 409 and tentativa < 5:
                        warn(f"{front}: container ocupado (409), aguardando 5s e repetindo...")
                        time.sleep(5)
                        continue
                    raise

            bench = result.get("benchmark_results", {})
            tp = bench.get("throughput", {})
            lat = bench.get("latency", {})

            ok(f"{front} benchmark completo!")
            if tp.get("ops_per_sec"):
                print(f"  Throughput: {tp['ops_per_sec']:.3f} ops/s")
            if lat.get("p50_ms"):
                print(f"  Latência p50: {lat['p50_ms']} ms  p99: {lat.get('p99_ms')} ms")
            scorecard = result.get("scorecard", {})
            primary = scorecard.get("primary_metric", {})
            if primary.get("value") is not None:
                print(f"  Métrica primária: {primary['value']:.3f} {primary.get('unit', '')}")
            if scorecard.get("performance_score") is not None:
                print(f"  Score: {scorecard['performance_score']:.1f}")
            eff = scorecard.get("efficiency", {})
            if eff.get("energy_per_op_j") is not None:
                print(f"  Energia/op: {eff['energy_per_op_j']:.6f} J")

            info("Resultado salvo pelo container em results/")

        except Exception as e:
            err(f"{front} benchmark falhou: {e}")
            failures += 1
    if failures:
        raise SystemExit(1)


def cmd_results(args):
    """Lista e exibe resultados de benchmarks."""
    results_dir = BASE_DIR / "results"
    if not results_dir.exists():
        warn("Nenhum resultado ainda. Execute './pdc benchmark <front>'")
        return

    sys.path.insert(0, str(BASE_DIR))
    from shared.result_parser import is_benchmark_result

    candidates = sorted(
        results_dir.glob("*.json"), key=lambda f: f.stat().st_mtime, reverse=True)
    json_files = []
    for path in candidates:
        try:
            with open(path, encoding="utf-8") as handle:
                if is_benchmark_result(json.load(handle)):
                    json_files.append(path)
        except (OSError, json.JSONDecodeError):
            continue
    if not json_files:
        warn("Nenhum resultado encontrado em results/")
        return

    if args.compare:
        from shared.result_parser import load_result_file, normalize_result
        from shared.scorecard import compute_scorecard, load_hardware_config

        rows = []
        hardware_config = load_hardware_config(str(BASE_DIR / "config" / "hardware.yaml"))
        results_root = results_dir.resolve()
        for name in args.compare:
            path = (results_dir / name).resolve()
            if not path.is_relative_to(results_root) or not path.is_file():
                err(f"Resultado não encontrado: {name}")
                raise SystemExit(1)
            try:
                raw, _row = load_result_file(str(path))
                if not is_benchmark_result(raw):
                    raise ValueError("arquivo não contém um benchmark")
                raw["scorecard"] = compute_scorecard(raw, hardware_config)
                row = normalize_result(raw, filename=str(path))
            except (OSError, json.JSONDecodeError, ValueError) as exc:
                err(f"Resultado inválido: {name} ({exc})")
                raise SystemExit(1)
            rows.append(row)

        header("Comparação de Resultados")
        print(f"  {'Métrica':28} {args.compare[0]:>24} {args.compare[1]:>24}")
        fields = (
            ("Throughput (ops/s)", "throughput_ops"),
            ("Latência p50 (ms)", "p50_ms"),
            ("Latência p95 (ms)", "p95_ms"),
            ("RAM pico (MB)", "peak_ram_mb"),
            ("RAM delta (MB)", "peak_ram_delta_mb"),
            ("VRAM pico (MB)", "peak_vram_mb"),
            ("VRAM delta (MB)", "peak_vram_delta_mb"),
            ("GPU média (%)", "avg_gpu_pct"),
            ("Energia (J)", "energy_j"),
            ("Energia/unidade (J)", "energy_per_primary_unit_j"),
            ("Score", "performance_score"),
            ("Custo/1k", "cost_per_1k"),
        )
        for label, key in fields:
            values = ["—" if row.get(key) is None else f"{row[key]:.6g}" for row in rows]
            print(f"  {label:28} {values[0]:>24} {values[1]:>24}")
        return

    if getattr(args, "scorecard", False):
        header("Scorecards")
        sys.path.insert(0, str(BASE_DIR))
        from shared.scorecard import compute_scorecard, load_hardware_config

        hw_cfg = load_hardware_config(str(BASE_DIR / "config" / "hardware.yaml"))
        for f in json_files[:20]:
            try:
                with open(f) as fp:
                    data = json.load(fp)
            except (OSError, json.JSONDecodeError) as exc:
                warn(f"{f.name}: resultado inválido ({exc})")
                continue
            sc = compute_scorecard(data, hw_cfg)
            primary = sc.get("primary_metric", {})
            score = sc.get("performance_score")
            eff = sc.get("efficiency", {})
            cost = sc.get("cost", {})
            metric = "—"
            if primary.get("value") is not None:
                metric = f"{primary['value']:.3f} {primary.get('unit', '')}"
            print(f"  {f.name:45}  score={score if score is not None else '—'}  metric={metric}  "
                  f"J/unid={eff.get('energy_per_primary_unit_j', '—')}  "
                  f"cost/1k={cost.get('cost_per_1k_primary_units', '—')}")
        return

    if args.latest:
        try:
            with open(json_files[0]) as f:
                data = json.load(f)
        except (OSError, json.JSONDecodeError) as exc:
            err(f"Resultado inválido: {json_files[0].name} ({exc})")
            raise SystemExit(1)
        print(json.dumps(data, indent=2))
        return

    header("Resultados de Benchmark")
    for f in json_files[:20]:
        size_kb = f.stat().st_size / 1024
        mtime = time.strftime("%Y-%m-%d %H:%M", time.localtime(f.stat().st_mtime))
        print(f"  {f.name:50}  {size_kb:6.1f} KB  {mtime}")


def cmd_models(args):
    """Gerencia modelos disponíveis."""
    try:
        import yaml
    except ImportError:
        err("PyYAML não está instalado. Execute './pdc setup'.")
        raise SystemExit(1)

    config_file = BASE_DIR / "config" / "models.yaml"
    if not config_file.exists():
        err("config/models.yaml não encontrado")
        sys.exit(1)

    with open(config_file) as f:
        models_cfg = yaml.safe_load(f)

    if args.models_cmd == "list":
        front_filter = getattr(args, "front_filter", None)
        header("Modelos Disponíveis")
        grouped = {}
        for front, name, model_cfg, is_default in _iter_models(models_cfg):
            if front_filter and front_filter not in (front, front.split("_")[0]):
                continue
            grouped.setdefault(front, []).append((name, model_cfg, is_default))
        for front, rows in grouped.items():
            print(f"\n{BOLD}{front.upper()}{RESET}")
            for name, model_cfg, is_default in rows:
                tag = f" {GREEN}[padrão]{RESET}" if is_default else ""
                print(f"  {name}{tag}")
                print(f"    {model_cfg.get('description', '')}")
                gpu_support = "sim" if model_cfg.get("gpu_capable", False) else "não"
                print(f"    Tamanho: {model_cfg.get('size_mb', '?')} MB  GPU: {gpu_support}")

    elif args.models_cmd == "download":
        sys.path.insert(0, str(BASE_DIR))
        from shared.model_loader import get_or_download

        front = args.front_filter
        model_name = args.model_name
        targets = _resolve_model_targets(models_cfg, front, model_name, defaults=args.defaults)
        if not targets:
            err("Nenhum modelo encontrado para download")
            sys.exit(1)

        cache_dir = str(BASE_DIR / "data" / "models")
        failures = 0
        for label, model_cfg in targets:
            urls = _model_download_items(model_cfg)
            if not urls:
                warn(f"{label}: sem URL direta. O runtime fará o download no primeiro carregamento.")
                continue
            for item in urls:
                info(f"Baixando {label}: {item.get('filename') or item.get('url', '').split('/')[-1]}")
                try:
                    path = get_or_download(item, cache_dir=cache_dir)
                    ok(f"Salvo em: {path}")
                except Exception as e:
                    failures += 1
                    err(f"{label}: download falhou: {e}")
        if failures:
            sys.exit(1)


def _iter_models(models_cfg):
    for front, cfg in models_cfg.items():
        if isinstance(cfg, dict) and "models" in cfg:
            default = cfg.get("default", "")
            for name, model_cfg in cfg.get("models", {}).items():
                yield front, name, model_cfg, name == default
            continue
        if isinstance(cfg, dict):
            for sub, sub_cfg in cfg.items():
                if isinstance(sub_cfg, dict) and "models" in sub_cfg:
                    default = sub_cfg.get("default", "")
                    label_front = f"{front}_{sub}" if front == "audio" else sub
                    for name, model_cfg in sub_cfg.get("models", {}).items():
                        yield label_front, name, model_cfg, name == default


def _resolve_model_targets(models_cfg, front, model_name, defaults=False):
    rows = list(_iter_models(models_cfg))
    if front in ("all", "*"):
        selected = rows
    elif front in ("defaults", "default"):
        selected = [row for row in rows if row[3]]
    else:
        selected = [row for row in rows if row[0] == front]
        if model_name:
            selected = [row for row in selected if row[1] == model_name]
        elif not defaults:
            selected = [row for row in selected if row[3]]

    if defaults:
        selected = [row for row in selected if row[3]]
    return [(f"{front}/{name}", cfg) for front, name, cfg, _default in selected]


def _model_download_items(model_cfg):
    items = []
    for key in ("config_url", "url", "model_url"):
        url = model_cfg.get(key)
        if not url:
            continue
        filename = model_cfg.get("filename") if key in ("url", "model_url") else None
        if not filename:
            filename = url.split("/")[-1].split("?")[0]
        item = {"url": url, "filename": filename}
        if key in ("url", "model_url") and model_cfg.get("sha256"):
            item["sha256"] = model_cfg["sha256"]
        items.append(item)
    return items


# --------------------------------------------------------------------- remoto
# Executa a plataforma em um device da frota (Jetson, Raspberry Pi, mini PC).
# Usa só ssh e rsync, que já existem nos dois lados: nenhum agente, nenhuma
# dependência nova no alvo. O device é o nome que o ~/.ssh/config resolve
# (jetson-nano, raspberry-pi5...) ou um usuario@host qualquer.

REMOTE_DEFAULT_PATH = "~/pdc-ia"
REMOTE_LOG = ".pdc-remote-run.log"
REMOTE_PID = ".pdc-remote-run.pid"

# O alvo compila e baixa por conta própria; mandar .venv, modelos ou resultados
# pela VPN é desperdício e ainda quebra (venv tem caminho absoluto e binário
# da arquitetura errada).
REMOTE_EXCLUDES = (
    ".git/", ".venv/", ".venv-test/", "__pycache__/", ".pytest_cache/", ".ruff_cache/",
    "data/models/", "data/datasets/", "data/hardware/", "data/telemetry/",
    "data/ultralytics/", "results/", "*.pyc", "*.log", ".pdc-remote-run.pid",
)

REMOTE_RESOLVE = r'''
case "$1" in
  /*)    P="$1" ;;
  "~/"*) P="$HOME/${1#\~/}" ;;
  *)     P="$HOME/$1" ;;
esac
'''

REMOTE_CHECK_SCRIPT = REMOTE_RESOLVE + r"""
set -u
p() { printf '%s=%s\n' "$1" "$2"; }
p arch "$(uname -m)"
p kernel "$(uname -r)"
p os "$(. /etc/os-release 2>/dev/null && echo "$PRETTY_NAME" || echo desconhecido)"
if command -v python3 >/dev/null 2>&1; then
  p python "$(python3 -c 'import sys;print("%d.%d"%sys.version_info[:2])' 2>/dev/null || echo erro)"
  python3 -c 'import venv, ensurepip' 2>/dev/null && p venv sim || p venv NAO
else
  p python AUSENTE; p venv NAO
fi
command -v docker >/dev/null 2>&1 \
  && p docker "$(docker --version 2>/dev/null | awk '{print $3}' | tr -d ,)" || p docker AUSENTE
docker compose version >/dev/null 2>&1 && p compose sim || p compose NAO
docker ps >/dev/null 2>&1 && p docker_sem_sudo sim || p docker_sem_sudo NAO
command -v rsync >/dev/null 2>&1 && p rsync sim || p rsync NAO
command -v git >/dev/null 2>&1 && p git "$(git --version 2>/dev/null | awk '{print $3}')" || p git AUSENTE
if [ -n "${2:-}" ] && command -v git >/dev/null 2>&1; then
  timeout 20 git ls-remote --heads "$2" >/dev/null 2>&1 && p origin alcancavel || p origin INALCANCAVEL
else
  p origin "?"
fi
p nproc "$(nproc 2>/dev/null || echo ?)"
p ram_mb "$(awk '/MemTotal/{printf "%d", $2/1024}' /proc/meminfo 2>/dev/null || echo ?)"
p livre_home "$(df -Pm "$HOME" 2>/dev/null | awk 'NR==2{printf "%d", $4}' || echo ?)"
[ -x /usr/bin/tegrastats ] && p tegrastats sim || p tegrastats nao
[ -f "$P/pdc" ] && p repo presente || p repo ausente
"""

# Ordem e rótulo do relatório do check. Só o que decide se roda ou não.
REMOTE_CHECK_FIELDS = (
    ("os", "Sistema"), ("arch", "Arquitetura"), ("kernel", "Kernel"),
    ("nproc", "CPUs"), ("ram_mb", "RAM (MB)"), ("livre_home", "Disco livre (MB)"),
    ("python", "Python"), ("venv", "módulo venv"), ("docker", "Docker"),
    ("compose", "docker compose"), ("docker_sem_sudo", "Docker sem sudo"),
    ("git", "git"), ("origin", "Acesso ao GitHub"), ("rsync", "rsync (só p/ --from-local)"),
    ("tegrastats", "tegrastats (Jetson)"), ("repo", "Repositório"),
)


def _ssh_base(device, tty=False):
    cmd = ["ssh"]
    if tty:
        cmd.append("-tt")
    # BatchMode: sem chave instalada falha na hora, em vez de travar num prompt
    # de senha que ninguém vai responder num script.
    cmd += ["-o", "BatchMode=yes", "-o", "ConnectTimeout=10", device]
    return cmd


def _ssh_script(device, script, script_args=(), capture=True, tty=False):
    """Roda um script bash no device mandando por stdin: sem inferno de aspas."""
    cmd = _ssh_base(device, tty=tty) + ["bash", "-s", "--", *script_args]
    if capture:
        return subprocess.run(cmd, input=script, text=True, capture_output=True)
    return subprocess.run(cmd, input=script, text=True)


def _remote_probe(device, remote_path, origin=""):
    """Coleta os pré-requisitos do device como pares chave=valor."""
    result = _ssh_script(device, REMOTE_CHECK_SCRIPT, [remote_path, origin])
    if result.returncode != 0:
        detail = (result.stderr or "").strip().splitlines()
        err(f"Não foi possível falar com {device} por SSH")
        for line in detail[:3]:
            print(f"    {line}", file=sys.stderr)
        info("Instale a chave pública no device e tente de novo.")
        raise SystemExit(1)
    return _parse_facts(result.stdout)


def _parse_facts(stdout):
    """Converte a saída chave=valor do probe em dicionário."""
    facts = {}
    for line in stdout.splitlines():
        if "=" in line:
            key, _, value = line.partition("=")
            facts[key.strip()] = value.strip()
    return facts


def _remote_blockers(facts, modo="git"):
    """Lista o que impede a execução. Vazio significa que dá para rodar.

    modo "git": o device baixa o código do GitHub com a internet dele.
    modo "local": o código é empurrado daqui, e aí sim precisa de rsync.
    """
    blockers = []
    if modo == "git":
        if facts.get("git", "AUSENTE") == "AUSENTE":
            blockers.append("git ausente no device (apt install git)")
        elif facts.get("origin") == "INALCANCAVEL":
            blockers.append("o device não alcança o GitHub; use --from-local")
    elif facts.get("rsync") != "sim":
        blockers.append("rsync ausente no device (apt install rsync), exigido por --from-local")
    if facts.get("docker", "AUSENTE") == "AUSENTE":
        blockers.append("Docker não instalado (curl -fsSL https://get.docker.com | sh)")
    if facts.get("compose") != "sim":
        blockers.append("plugin docker compose ausente (instale docker-compose-plugin)")
    if facts.get("docker_sem_sudo") != "sim":
        blockers.append(
            "usuário não usa Docker sem sudo "
            "(sudo usermod -aG docker $USER e reabra a sessão)")
    if facts.get("python", "AUSENTE") == "AUSENTE":
        blockers.append("Python 3 ausente")
    else:
        try:
            versao = tuple(int(n) for n in facts["python"].split(".")[:2])
        except ValueError:
            versao = None
        if versao is None:
            blockers.append("não foi possível ler a versão do Python no device")
        elif versao < (3, 10):
            blockers.append(f"Python {facts['python']} é antigo demais; o projeto pede 3.10+")
    if facts.get("venv") != "sim":
        blockers.append("venv/ensurepip ausente (apt install python3-venv; no Jetson python3.10-venv)")
    arch = facts.get("arch", "")
    if arch in {"armv7l", "armv6l"}:
        blockers.append(
            f"{arch} é ARM 32 bits: só o agente de telemetria roda. "
            "Visão, SLM e áudio exigem ARM64 (veja docs/ARM.md)")
    return blockers


def _remote_cpu_only(facts):
    """ARM não tem imagem CUDA neste repositório; força a variante CPU."""
    return facts.get("arch", "").lower() not in {"x86_64", "amd64"}


def _git_local(*args, padrao=""):
    """Roda um git no repositório local e devolve a saída limpa."""
    result = subprocess.run(
        ["git", "-C", str(BASE_DIR), *args], capture_output=True, text=True)
    return result.stdout.strip() if result.returncode == 0 else padrao


def _git_origin():
    return _git_local("remote", "get-url", "origin")


def _git_ref_atual():
    return _git_local("rev-parse", "--abbrev-ref", "HEAD", padrao="main")


def _avisos_de_defasagem(ref):
    """Avisa quando o device vai rodar código diferente do que está aqui.

    É a armadilha do modo git: o device baixa o que está no GitHub, não o que
    está nesta pasta. Um benchmark medindo código antigo passa despercebido.
    """
    avisos = []
    sujo = _git_local("status", "--porcelain")
    if sujo:
        avisos.append(
            f"{len(sujo.splitlines())} arquivo(s) sem commit aqui não vão para o device")
    pendentes = _git_local("rev-list", "--count", f"origin/{ref}..{ref}", padrao="0")
    if pendentes not in {"0", ""}:
        avisos.append(f"{pendentes} commit(s) locais ainda não enviados para o origin")
    return avisos


REMOTE_GIT_SCRIPT = REMOTE_RESOLVE + r'''
URL="$2"; REF="$3"
if [ ! -d "$P/.git" ]; then
    mkdir -p "$P" || exit 1
    git clone "$URL" "$P" || exit 1
fi
cd "$P" || exit 1
git remote set-url origin "$URL" || exit 1
git fetch origin "$REF" || exit 1
# checkout -f deixa o HEAD destacado no commit exato: o resultado do benchmark
# fica atrelado a um SHA, e nao a "seja la o que a branch era naquele dia".
git checkout -f FETCH_HEAD || exit 1
git --no-pager log -1 --format="__PDC_SHA__=%h %s"
'''


def cmd_remote(args):
    """Despacha os subcomandos de execução remota."""
    actions = {
        "check": _remote_check, "deploy": _remote_deploy,
        "run": _remote_run, "logs": _remote_logs, "fetch": _remote_fetch,
    }
    actions[args.remote_command](args)


def _remote_check(args):
    """Mostra se o device tem o necessário para rodar a plataforma."""
    remote_path = args.path
    facts = _remote_probe(args.device, remote_path, _git_origin())
    print(f"\n{BOLD}{args.device}{RESET}  ({remote_path})")
    for key, label in REMOTE_CHECK_FIELDS:
        value = facts.get(key, "?")
        color = RED if value in {"NAO", "AUSENTE"} else ""
        reset = RESET if color else ""
        print(f"  {label:<22} {color}{value}{reset}")
    blockers = _remote_blockers(facts)
    print()
    if blockers:
        err(f"{len(blockers)} pendência(s) antes de rodar:")
        for item in blockers:
            print(f"    - {item}")
        raise SystemExit(1)
    modo = "CPU (ARM)" if _remote_cpu_only(facts) else "auto (x86_64)"
    ok(f"Pronto para rodar em modo {modo}")
    if facts.get("repo") == "ausente":
        info(f"Repositório ainda não está lá. Rode: ./pdc remote deploy {args.device}")


def _remote_deploy(args):
    """Coloca o código no device e prepara o ambiente.

    Por padrão o próprio device baixa do GitHub com a internet dele: não passa
    pela VPN e o benchmark fica atrelado a um commit. --from-local envia o que
    está nesta pasta, para testar trabalho ainda sem commit.
    """
    modo = "local" if args.from_local else "git"
    origin = _git_origin() if modo == "git" else ""
    facts = _remote_probe(args.device, args.path, origin)
    blockers = _remote_blockers(facts, modo)
    if blockers:
        err("O device não passou no check:")
        for item in blockers:
            print(f"    - {item}")
        info(f"Detalhes: ./pdc remote check {args.device}")
        raise SystemExit(1)

    if modo == "git":
        if not origin:
            err("Este repositório não tem 'origin'. Use --from-local.")
            raise SystemExit(1)
        ref = args.ref or _git_ref_atual()
        for aviso in _avisos_de_defasagem(ref):
            warn(aviso)
        info(f"{args.device} baixando {ref} de {origin} pela internet dele ...")
        result = _ssh_script(
            args.device, REMOTE_GIT_SCRIPT, [args.path, origin, ref], capture=True)
        sha = ""
        for linha in (result.stdout or "").splitlines():
            if linha.startswith("__PDC_SHA__="):
                sha = linha.split("=", 1)[1]
        if result.returncode != 0 or not sha:
            err(f"Falhou ao baixar {ref} no device")
            print((result.stderr or "").strip()[:600], file=sys.stderr)
            raise SystemExit(1)
        ok(f"Código em {sha}")
    else:
        info(f"Enviando esta pasta para {args.device}:{args.path} ...")
        excludes = []
        for pattern in REMOTE_EXCLUDES:
            excludes += ["--exclude", pattern]
        rsync = subprocess.run([
            "rsync", "-az", "--delete", "--info=stats1",
            "-e", "ssh -o BatchMode=yes -o ConnectTimeout=10",
            *excludes, f"{BASE_DIR}/", f"{args.device}:{args.path}/",
        ])
        if rsync.returncode != 0:
            err("rsync falhou")
            raise SystemExit(1)
        ok("Código sincronizado")

    steps = [("./pdc setup", "ambiente Python")]
    if not args.no_models:
        steps.append(("./pdc models download defaults", "modelos padrão"))
    for command, label in steps:
        info(f"Preparando {label} em {args.device} ...")
        result = _ssh_script(
            args.device, REMOTE_RESOLVE + f'cd "$P" && {command}\n', [args.path],
            capture=False)
        if result.returncode != 0:
            err(f"Falhou: {command}")
            raise SystemExit(1)
        ok(label)
    ok(f"{args.device} pronto. Agora: ./pdc remote run {args.device}")


def _remote_run(args):
    """Roda build, up e benchmark no device e traz os resultados."""
    facts = _remote_probe(args.device, args.path)
    if facts.get("repo") != "presente":
        err(f"O projeto não está em {args.device}:{args.path}")
        info(f"Rode antes: ./pdc remote deploy {args.device}")
        raise SystemExit(1)
    blockers = _remote_blockers(facts, modo="local")
    if blockers:
        err("O device não passou no check:")
        for item in blockers:
            print(f"    - {item}")
        raise SystemExit(1)

    modo = " --cpu" if _remote_cpu_only(facts) else ""
    front = args.front
    # status fica fora do encadeamento: ele retorna != 0 enquanto os containers
    # ainda aquecem (start_period), o que mataria a cadeia antes do benchmark.
    # O benchmark agora espera /health por conta própria.
    remote_cmds = (
        f"./pdc build {front}{modo} && "
        f"./pdc up {front}{modo} && "
        f"./pdc benchmark {front} --profile {args.profile}"
    )
    launcher = _remote_launcher(remote_cmds)
    start = _ssh_script(args.device, launcher, [args.path])
    if "__PDC_BUSY__" in (start.stdout or ""):
        err(f"Já existe um benchmark rodando em {args.device}")
        info(f"Acompanhe com: ./pdc remote logs {args.device}")
        raise SystemExit(1)
    if start.returncode != 0 or "__PDC_STARTED__" not in (start.stdout or ""):
        err("Não foi possível iniciar o benchmark")
        print((start.stderr or "").strip(), file=sys.stderr)
        raise SystemExit(1)

    ok(f"Benchmark iniciado em {args.device} (perfil {args.profile}, frente {front})")
    if args.detach:
        info(f"Rodando solto. Acompanhe: ./pdc remote logs {args.device}")
        info(f"Ao terminar:            ./pdc remote fetch {args.device}")
        return
    code = _remote_stream(args.device, args.path)
    _remote_fetch(args)
    if code is None:
        return
    if code != 0:
        err(f"Benchmark terminou com código {code}")
        raise SystemExit(1)
    ok("Benchmark concluído")


def _remote_launcher(remote_cmds):
    """Monta o script que dispara o trabalho solto do terminal no device.

    setsid + nohup porque um benchmark em Raspberry Pi leva horas e a sessão
    passa por uma VPN: sem isso, uma queda de link mata o teste no meio.
    """
    return REMOTE_RESOLVE + (
        'cd "$P" || exit 1\n'
        f'if [ -f {REMOTE_PID} ] && kill -0 "$(cat {REMOTE_PID})" 2>/dev/null; then\n'
        '  echo "__PDC_BUSY__"; exit 3\n'
        'fi\n'
        # Os parênteses existem para que um exit dentro da cadeia não pule a
        # sentinela: sem ela, quem acompanha o log esperaria para sempre.
        f'setsid nohup bash -c \'echo $$ > {REMOTE_PID}; ({remote_cmds}); '
        f'echo "__PDC_RC__=$?"\' '
        f'> {REMOTE_LOG} 2>&1 < /dev/null &\n'
        'sleep 1; echo "__PDC_STARTED__"\n'
    )


def _remote_stream(device, remote_path):
    """Acompanha o log até o processo terminar. Devolve o código de saída dele.

    Segue o PID e não só a sentinela: um benchmark morto por OOM na placa não
    escreve sentinela nenhuma, e sem isso o acompanhamento travaria calado.
    """
    script = REMOTE_RESOLVE + (
        'cd "$P" || exit 1\n'
        'PID=$(cat "$3" 2>/dev/null || true)\n'
        'if [ -n "${PID:-}" ] && kill -0 "$PID" 2>/dev/null; then\n'
        '  tail -n +1 -f --pid="$PID" "$2"\n'
        'else\n'
        '  cat "$2" 2>/dev/null\n'
        'fi\n'
    )
    proc = subprocess.Popen(
        _ssh_base(device) + ["bash", "-s", "--", remote_path, REMOTE_LOG, REMOTE_PID],
        stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True,
    )
    proc.stdin.write(script)
    proc.stdin.close()
    code = None
    try:
        for line in proc.stdout:
            if line.startswith("__PDC_RC__="):
                code = int(line.strip().split("=", 1)[1] or 1)
                break
            print(line, end="", flush=True)
    except KeyboardInterrupt:
        warn("Saindo do acompanhamento. O benchmark continua rodando no device.")
        info(f"Reata com: ./pdc remote logs {device}")
    finally:
        proc.terminate()
    if code is None:
        warn("O processo terminou sem registrar o código de saída (pode ter sido morto).")
    return code  # None = ainda rodando, interrompido, ou morto sem sentinela


def _remote_logs(args):
    """Reata ao log de uma execução em andamento."""
    raise SystemExit(_remote_stream(args.device, args.path) or 0)


def _remote_fetch(args):
    """Traz os resultados do device para o destino local (--out)."""
    base = Path(os.path.expanduser(args.out)) if getattr(args, "out", None) else BASE_DIR / "results" / "remote"
    destino = base / args.device.replace("/", "_")
    destino.mkdir(parents=True, exist_ok=True)
    info(f"Trazendo resultados para {destino.relative_to(BASE_DIR)}/ ...")
    result = subprocess.run([
        "rsync", "-az", "--info=stats1",
        "-e", "ssh -o BatchMode=yes -o ConnectTimeout=10",
        f"{args.device}:{args.path}/results/", f"{destino}/",
    ])
    if result.returncode != 0:
        warn("Nenhum resultado trazido (o device pode não ter gerado nenhum ainda)")
        return
    arquivos = sorted(destino.rglob("*.json"))
    ok(f"{len(arquivos)} arquivo(s) em {destino}")


def main():
    parser = argparse.ArgumentParser(
        prog="pdc",
        description="PDC-IA — CLI para benchmark de hardware com modelos de IA",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    sub = parser.add_subparsers(dest="command")

    sub.add_parser("setup", help="Prepara o ambiente Python local")
    sub.add_parser("dashboard", help="Inicia o dashboard local")

    # detect
    p_detect = sub.add_parser("detect", help="Detecta hardware do sistema")
    p_detect.add_argument("--json", action="store_true", help="Exibe saída em JSON")
    p_detect.add_argument(
        "--save", action="store_true", help="Salva o inventário em data/hardware/")

    # build
    p_build = sub.add_parser("build", help="Constrói containers")
    p_build.add_argument("front", help="Nome da frente (vision|slm|audio|all)")
    p_build.add_argument("--gpu", action="store_true", help="Constrói variante NVIDIA")
    p_build.add_argument("--cpu", action="store_true", help="Constrói variante CPU portátil")

    # up
    p_up = sub.add_parser("up", help="Sobe containers")
    p_up.add_argument("front", help="Nome da frente ou 'all'")
    p_up.add_argument("--gpu", action="store_true", help="Força uso de GPU")
    p_up.add_argument("--cpu", action="store_true", help="Força uso de CPU")

    # down
    p_down = sub.add_parser("down", help="Para containers")
    p_down.add_argument("front", help="Nome da frente ou 'all'")

    # status
    sub.add_parser("status", help="Status dos containers")

    # benchmark
    p_bench = sub.add_parser("benchmark", help="Executa benchmark")
    p_bench.add_argument("front", help="Nome da frente ou 'all'")
    p_bench.add_argument("--quick", action="store_true", help="Perfil rápido (30s)")
    p_bench.add_argument("--profile", help="Perfil: express|quick|standard|extended")
    p_bench.add_argument(
        "--mode", choices=("asr", "tts", "pipeline"),
        help="Modo da frente de áudio (padrão: pipeline)",
    )
    p_bench.add_argument(
        "--timeout", type=_positive_int,
        default=DEFAULT_BENCHMARK_TIMEOUT,
        help="Tempo máximo por frente em segundos (padrão: 21600)",
    )

    # results
    p_res = sub.add_parser("results", help="Lista resultados")
    p_res.add_argument("--latest", action="store_true", help="Mostra resultado mais recente")
    p_res.add_argument("--scorecard", action="store_true", help="Lista scorecards dos resultados")
    p_res.add_argument("--compare", nargs=2, metavar=("F1", "F2"), help="Compara dois arquivos")

    # models
    p_models = sub.add_parser("models", help="Gerencia modelos")
    models_sub = p_models.add_subparsers(dest="models_cmd")
    p_models_list = models_sub.add_parser("list", help="Lista modelos")
    p_models_list.add_argument("front_filter", nargs="?", help="Filtra por frente")
    p_models_dl = models_sub.add_parser(
        "download",
        help="Baixa modelos configurados",
        description=(
            "Exemplos:\n"
            "  ./pdc models download defaults\n"
            "  ./pdc models download all\n"
            "  ./pdc models download slm tinyllama-1.1b-q4\n"
            "  ./pdc models download audio_tts --defaults"
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    p_models_dl.add_argument("front_filter", metavar="front", help="vision|slm|audio_asr|audio_tts|defaults|all")
    p_models_dl.add_argument("model_name", nargs="?", metavar="model")
    p_models_dl.add_argument("--defaults", action="store_true", help="Baixa apenas modelos padrão")

    # remote
    p_remote = sub.add_parser(
        "remote",
        help="Executa a plataforma em um device da frota via SSH",
        description=(
            "Roda a plataforma em um device da frota (Jetson, Raspberry Pi, mini PC).\n"
            "device e o nome que o ~/.ssh/config resolve, ou usuario@host.\n\n"
            "  ./pdc remote check  jetson-nano\n"
            "  ./pdc remote deploy jetson-nano\n"
            "  ./pdc remote run    jetson-nano --profile express\n"
            "  ./pdc remote logs   jetson-nano\n"
            "  ./pdc remote fetch  jetson-nano"
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    remote_sub = p_remote.add_subparsers(dest="remote_command", required=True)
    for nome, ajuda in (
        ("check", "Verifica pre-requisitos no device"),
        ("deploy", "Envia o projeto e prepara o ambiente"),
        ("run", "Roda build, up e benchmark e traz os resultados"),
        ("logs", "Acompanha o log de uma execucao em andamento"),
        ("fetch", "Traz os resultados do device"),
    ):
        p_sub = remote_sub.add_parser(nome, help=ajuda)
        p_sub.add_argument("device", help="Nome no ~/.ssh/config ou usuario@host")
        p_sub.add_argument(
            "--path", default=REMOTE_DEFAULT_PATH,
            help=f"Caminho no device (padrao: {REMOTE_DEFAULT_PATH})")
        if nome in ("run", "fetch"):
            p_sub.add_argument(
                "--out", help="Pasta local para os resultados (padrao: results/remote/)")
        if nome == "deploy":
            p_sub.add_argument(
                "--no-models", action="store_true",
                help="Nao baixa os modelos padrao no device")
            p_sub.add_argument(
                "--ref", help="Branch ou tag a baixar (padrao: a branch atual daqui)")
            p_sub.add_argument(
                "--from-local", action="store_true",
                help="Envia esta pasta por rsync em vez de o device baixar do git")
        if nome == "run":
            p_sub.add_argument(
                "--front", default="all", help="vision|slm|audio|all (padrao: all)")
            p_sub.add_argument(
                "--profile", default="express",
                help="express|quick|standard|extended (padrao: express)")
            p_sub.add_argument(
                "--detach", action="store_true",
                help="Inicia e volta ao terminal sem acompanhar o log")

    args = parser.parse_args()

    if args.command == "setup":
        cmd_setup(args)
    elif args.command == "dashboard":
        cmd_dashboard(args)
    elif args.command == "detect":
        cmd_detect(args)
    elif args.command == "build":
        cmd_build(args)
    elif args.command == "up":
        cmd_up(args)
    elif args.command == "down":
        cmd_down(args)
    elif args.command == "status":
        cmd_status(args)
    elif args.command == "benchmark":
        cmd_benchmark(args)
    elif args.command == "results":
        cmd_results(args)
    elif args.command == "models":
        cmd_models(args)
    elif args.command == "remote":
        cmd_remote(args)
    else:
        parser.print_help()


if __name__ == "__main__":
    main()
