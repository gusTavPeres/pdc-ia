FROM nvidia/cuda:12.1.1-devel-ubuntu22.04

RUN set -eux; \
    packages="build-essential cmake curl python3 python3-dev python3-pip"; \
    for attempt in 1 2 3; do \
        rm -rf /var/lib/apt/lists/*; \
        if apt-get -o Acquire::Retries=3 update \
            && apt-get -o Acquire::Retries=3 install -y --no-install-recommends $packages; then \
            break; \
        fi; \
        if [ "$attempt" -eq 3 ]; then exit 1; fi; \
        sleep 5; \
    done; \
    rm -rf /var/lib/apt/lists/*

RUN python3 -m pip install --upgrade pip setuptools wheel scikit-build
RUN ln -s /usr/local/cuda/lib64/stubs/libcuda.so \
    /usr/local/cuda/lib64/stubs/libcuda.so.1

WORKDIR /app

COPY shared/requirements.txt /app/shared_req.txt
RUN pip install --no-cache-dir -r /app/shared_req.txt
RUN pip install --no-cache-dir fastapi "uvicorn[standard]"

ENV CMAKE_ARGS="-DGGML_CUDA=on" \
    CUDACXX=/usr/local/cuda/bin/nvcc \
    FORCE_CMAKE=1 \
    LD_LIBRARY_PATH=/usr/local/cuda/lib64/stubs:/usr/local/cuda/lib64 \
    LIBRARY_PATH=/usr/local/cuda/lib64/stubs:/usr/local/cuda/lib64
RUN pip install --no-cache-dir llama-cpp-python==0.3.34 \
    --no-binary llama-cpp-python

RUN rm -f /usr/local/cuda/lib64/stubs/libcuda.so.1

COPY slm/app/ /app/app/

ENV PYTHONPATH=/app \
    PDC_FRONT=slm \
    PDC_GPU_MODE=auto \
    LD_LIBRARY_PATH=/usr/local/cuda/lib64

HEALTHCHECK --interval=30s --timeout=10s --start-period=300s --retries=10 \
    CMD curl -sf http://localhost:8000/health || exit 1

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
