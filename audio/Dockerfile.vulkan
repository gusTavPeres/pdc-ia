# Audio (Whisper ASR) na GPU via Vulkan — whisper.cpp (whisper-server) com
# GGML_VULKAN, p/ GPUs AMD/iGPU (Radeon 890M). Modelo residente no server.
# Base Ubuntu 24.04 pelo RADV/Mesa recente (GFX1150 exige Mesa >=24).
FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive PIP_BREAK_SYSTEM_PACKAGES=1

RUN set -eux; \
    packages="python3 python3-pip build-essential cmake git curl ca-certificates \
              ffmpeg libsndfile1 libgomp1 \
              libvulkan-dev vulkan-tools mesa-vulkan-drivers \
              glslc glslang-tools glslang-dev spirv-headers spirv-tools"; \
    for attempt in 1 2 3; do \
        rm -rf /var/lib/apt/lists/*; \
        if apt-get -o Acquire::Retries=3 update \
            && apt-get -o Acquire::Retries=3 install -y --no-install-recommends $packages; then \
            break; \
        fi; \
        [ "$attempt" -eq 3 ] && exit 1; sleep 5; \
    done; \
    rm -rf /var/lib/apt/lists/*

# whisper.cpp com Vulkan (so o whisper-server)
RUN git clone --depth 1 https://github.com/ggml-org/whisper.cpp /opt/whisper.cpp \
    && cmake -S /opt/whisper.cpp -B /opt/whisper.cpp/build \
        -DGGML_VULKAN=ON -DWHISPER_BUILD_TESTS=OFF -DWHISPER_BUILD_EXAMPLES=ON \
    && cmake --build /opt/whisper.cpp/build -j --config Release --target whisper-server

WORKDIR /app

COPY shared/requirements.txt /app/shared_req.txt
RUN pip3 install --no-cache-dir -r /app/shared_req.txt
RUN pip3 install --no-cache-dir fastapi "uvicorn[standard]" python-multipart requests soundfile

COPY audio/app/ /app/app/

ENV PYTHONPATH=/app \
    PDC_FRONT=audio \
    PDC_GPU_MODE=auto \
    PDC_GPU_BACKEND=vulkan

HEALTHCHECK --interval=30s --timeout=10s --start-period=300s --retries=10 \
    CMD curl -sf http://localhost:8000/health || exit 1

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
