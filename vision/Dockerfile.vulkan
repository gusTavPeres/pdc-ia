# Vision (YOLO) na GPU via Vulkan (ncnn) — p/ GPUs AMD/iGPU (Radeon 890M).
# ultralytics exporta o .pt -> ncnn; a inferencia forca use_vulkan_compute.
# Base Ubuntu 24.04 pelo RADV/Mesa recente (GFX1150 exige Mesa >=24).
FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive PIP_BREAK_SYSTEM_PACKAGES=1

RUN set -eux; \
    packages="python3 python3-pip curl ca-certificates \
              libvulkan1 mesa-vulkan-drivers \
              libgl1 libglib2.0-0 libsm6 libxext6 libxrender1"; \
    for attempt in 1 2 3; do \
        rm -rf /var/lib/apt/lists/*; \
        if apt-get -o Acquire::Retries=3 update \
            && apt-get -o Acquire::Retries=3 install -y --no-install-recommends $packages; then \
            break; \
        fi; \
        [ "$attempt" -eq 3 ] && exit 1; sleep 5; \
    done; \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY shared/requirements.txt /app/shared_req.txt
RUN pip3 install --no-cache-dir -r /app/shared_req.txt
# torch CPU (ultralytics usa p/ carregar/exportar o .pt); inferencia roda no ncnn/Vulkan
RUN pip3 install --no-cache-dir torch torchvision --index-url https://download.pytorch.org/whl/cpu
RUN pip3 install --no-cache-dir ncnn ultralytics onnx onnxslim opencv-python-headless \
    fastapi "uvicorn[standard]" python-multipart

COPY vision/app/ /app/app/

ENV PYTHONPATH=/app \
    PDC_FRONT=vision \
    PDC_GPU_MODE=auto \
    PDC_GPU_BACKEND=vulkan \
    YOLO_CONFIG_DIR=/app/data/ultralytics

HEALTHCHECK --interval=30s --timeout=10s --start-period=240s --retries=10 \
    CMD curl -sf http://localhost:8000/health || exit 1

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
